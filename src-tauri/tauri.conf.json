{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mister Joe",
  "version": "0.1.5",
  "identifier": "app.misterjoe.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mister Joe",
        "url": "index.html",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "pill",
        "title": "Mister Joe is listening",
        "url": "pill.html",
        "width": 300,
        "height": 84,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "backgroundThrottling": "disabled",
        "visible": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Dictation that stays on your device",
    "longDescription": "Hold Option (Alt on Windows and Linux), talk, and Mister Joe types it into any app. Speech is transcribed on your computer and never leaves it.",
    "resources": {
      "resources/models/*": "models/",
      "resources/samples/*": "samples/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
